precision highp float;uniform float uYear;varying vec3 vNormal;varying vec3 vWorld;float h(vec3 p){return fract(sin(dot(floor(p*20.),vec3(12.7,41.3,73.1)))*43758.5);}void main(){vec3 p=normalize(vWorld);float lat=asin(p.y),existence=smoothstep(-300000.,-1000.,uYear),density=existence*exp(-abs(lat)/.52)*(.55+.45*h(p));vec3 c=mix(vec3(.02,.65,.16),vec3(.02,.25,1.),smoothstep(0.,.01,density));c=mix(c,vec3(1.,0.,0.),smoothstep(.12,.55,density));gl_FragColor=vec4(c,.72);}