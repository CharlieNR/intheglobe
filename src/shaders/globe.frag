precision highp float;uniform float uYear;uniform float uHeatmap;varying vec3 vNormal;varying vec3 vWorld;varying float vElevation;float hash(vec3 p){return fract(sin(dot(p,vec3(12.9898,78.233,37.719)))*43758.5453);}vec3 biome(float lat,float elev,vec3 p){float cold=smoothstep(.45,.9,abs(lat)),hot=1.-smoothstep(.05,.55,abs(lat)),n=hash(floor(p*18.));vec3 ocean=vec3(.025,.12,.20),land=mix(vec3(.16,.30,.12),vec3(.52,.38,.16),hot*.65+n*.2);land=mix(land,vec3(.88,.88,.82),cold);land=mix(land,vec3(.20,.20,.18),smoothstep(.035,.07,elev));return mix(ocean,land,smoothstep(-.003,.003,elev));}void main(){vec3 p=normalize(vWorld);float lat=asin(p.y);vec3 base=biome(lat,vElevation,p);float pop=0.;if(uYear>=-300000.){float hab=exp(-abs(lat)/.55)*smoothstep(-.01,.03,vElevation),coast=1.-smoothstep(0.,.04,abs(vElevation));pop=hab*(.55+.45*coast)*smoothstep(-300000.,0.,uYear);pop*=.65+.35*hash(floor(p*20.));}vec3 heat=mix(vec3(.05,.55,.18),vec3(.05,.25,1.),smoothstep(0.,.015,pop));heat=mix(heat,vec3(1.,.05,.02),smoothstep(.18,.8,pop));base=mix(base,heat,pop*uHeatmap*.82);float light=.55+.45*max(dot(vNormal,normalize(vec3(1.5,.7,2.))),0.);gl_FragColor=vec4(base*light,1.);}