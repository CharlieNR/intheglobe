precision highp float;uniform float uTectonic;varying vec3 vNormal;varying vec3 vWorld;varying float vElevation;float hash(vec3 p){p=fract(p*.3183099+.1);p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}float noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z)*2.-1.;}float fbm(vec3 p){float a=.5,s=0.;for(int i=0;i<5;i++){s+=a*noise(p);p*=2.03;a*=.5;}return s;}void main(){vec3 n=normalize(position);float broad=fbm(n*2.2+vec3(uTectonic*.000000001));float detail=fbm(n*7.);float elevation=broad*.035+detail*.008;float collision=pow(max(0.,sin(n.x*9.+n.y*7.+n.z*5.)),12.);elevation+=collision*.018;vec3 displaced=n*(1.+elevation);vElevation=elevation;vNormal=normalize(normalMatrix*n);vec4 world=modelMatrix*vec4(displaced,1.);vWorld=world.xyz;gl_Position=projectionMatrix*viewMatrix*world;}